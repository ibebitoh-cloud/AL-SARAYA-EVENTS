// Cloudflare Workers config: serve the Vite build as static assets, with SPA fallback to index.html.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "al-saraya-events",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
